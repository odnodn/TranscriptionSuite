# TranscriptionSuite — DGX Spark Dockerfile
#
# Purpose: Run TranscriptionSuite on NVIDIA DGX Spark (Blackwell GB10, sm_121, aarch64).
#
# The standard Dockerfile (FROM ubuntu:24.04) cannot target sm_121 because:
#   - PyTorch cu129 wheels only ship sm_70..sm_120 (Volta → Blackwell B-series).
#   - The DGX Spark's GB10 SoC requires sm_121 CUDA kernels.
#   - The deadsnakes PPA does not publish aarch64 builds for Ubuntu 24.04.
#
# This Dockerfile uses the NVIDIA PyTorch container (nvcr.io/nvidia/pytorch),
# which ships pre-built CUDA 12.x + cuDNN libraries with sm_121 support on
# aarch64, solving both problems at once.
#
# Adapted from nemotron-asr-server (https://github.com/briancaffey/nemotron-asr-server)
# — base image selection pattern for DGX Spark sm_121 aarch64 support.
#
# Build (from the repository root):
#   docker build -f server/docker/Dockerfile.dgx-spark -t transcriptionsuite-server:dgx-spark .
#
# Usage with compose:
#   docker compose -f docker-compose.yml -f docker-compose.linux-host.yml \
#                  -f docker-compose.dgx-spark.yml up -d

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.09-py3
FROM ${BASE_IMAGE} AS runtime

# Fixed variant — DGX Spark always uses the NGC container's bundled CUDA.
# This value is checked by bootstrap_runtime.py; "dgx-spark" tells it to
# skip the PyTorch index swap entirely (CUDA is pre-installed in the base).
ARG PYTORCH_VARIANT=dgx-spark

# OCI standard labels
LABEL org.opencontainers.image.title="TranscriptionSuite Server (DGX Spark)"
LABEL org.opencontainers.image.description="TranscriptionSuite server for NVIDIA DGX Spark (Blackwell GB10 sm_121, aarch64)"
LABEL org.opencontainers.image.authors="homelab-00"
LABEL org.opencontainers.image.vendor="homelab-00"
LABEL org.opencontainers.image.source="https://github.com/homelab-00/TranscriptionSuite"
LABEL org.opencontainers.image.url="https://github.com/homelab-00/TranscriptionSuite"
LABEL org.opencontainers.image.documentation="https://github.com/homelab-00/TranscriptionSuite/blob/main/README.md"
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"

# Global environment
ENV DEBIAN_FRONTEND="noninteractive"
ENV PYTHONUNBUFFERED="1"
ENV PYTHONDONTWRITEBYTECODE="1"
# The NGC base image ships Python 3.12; uv must target the same version.
ENV UV_PYTHON="3.12"
ENV PYTORCH_VARIANT="${PYTORCH_VARIANT}"
ENV BOOTSTRAP_RUNTIME_DIR="/runtime"
ENV BOOTSTRAP_CACHE_DIR="/runtime/cache"
ENV BOOTSTRAP_STATUS_FILE="/runtime/bootstrap-status.json"
ENV BOOTSTRAP_TIMEOUT_SECONDS="1800"
ENV BOOTSTRAP_REQUIRE_HF_TOKEN="false"
ENV BOOTSTRAP_LOG_CHANGES="true"
ENV UV_CACHE_DIR="/runtime/cache"
ENV HF_HOME="/models"
ENV TORCH_HOME="/models/torch-cache"
ENV PYTHONWARNINGS="ignore::UserWarning:pyannote.audio.core.io"

# Install additional system deps not in the NGC base.
# The NGC image already includes: build-essential, python3, ffmpeg (often),
# curl, git, ca-certificates. We add only what's missing.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libportaudio2 \
    portaudio19-dev \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast Python package manager)
RUN curl -LsSf https://astral.sh/uv/0.10.8/install.sh | env UV_UNMANAGED_INSTALL="/usr/local/bin" sh

# Create non-root user for security with pinned UID/GID
RUN groupadd -g 10000 appuser && \
    useradd -u 10000 -g 10000 -m -s /bin/bash appuser

# Create app directory
WORKDIR /app

# Copy server application code and bootstrap tooling.
COPY --chown=appuser:appuser server/backend/ ./server/
COPY --chown=appuser:appuser server/docker/entrypoint.py ./docker/
COPY --chown=appuser:appuser server/docker/bootstrap_runtime.py ./docker/
COPY server/docker/docker-entrypoint.sh ./docker/
COPY server/docker/install_ca_certs.py ./docker/
RUN chmod 700 ./docker/docker-entrypoint.sh

# Copy default configuration
COPY server/config.yaml ./config.yaml

# Bake the resolved PYTORCH_VARIANT
RUN printf '%s\n' "${PYTORCH_VARIANT}" > /app/.pytorch_variant && \
    chown appuser:appuser /app/.pytorch_variant && \
    chmod 0644 /app/.pytorch_variant

# Create data directories with correct permissions
RUN mkdir -p /data/database /data/audio /data/logs /data/tokens /data/certs /models /user-config /certs /runtime /runtime/cache && \
    chown -R appuser:appuser /data /models /user-config /runtime

# Environment variables
ENV DATA_DIR="/data"
ENV SERVER_HOST="0.0.0.0"
ENV SERVER_PORT="9786"
ENV LOG_LEVEL="INFO"
# The NGC base image puts CUDA/cuDNN libs on LD_LIBRARY_PATH already.
# Append the runtime venv paths so bootstrap-installed packages (torch, etc.)
# can also be found. The NGC image sets LD_LIBRARY_PATH, so we extend it.
ENV LD_LIBRARY_PATH="/runtime/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/runtime/.venv/lib/python3.12/site-packages/torch/lib:${LD_LIBRARY_PATH}"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True,garbage_collection_threshold:0.8"

# Expose port
EXPOSE 9786

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=600s --retries=3 \
    CMD curl -f http://localhost:${SERVER_PORT}/health || exit 1

# Shell entrypoint handles TLS cert permissions then drops to appuser
ENTRYPOINT ["./docker/docker-entrypoint.sh"]
CMD []
